  "passages": [
    {
      "window": [
        14,
        31
      ],
      "segments": [
        {
          "start": 14.0,
          "end": 16.92,
          "text": "Od stalaktitu cez stalagmit až po stalagmáty."
        },
        {
          "start": 17.06,
          "end": 19.12,
          "text": "Veda nás obklopuje na každom kroku."
        },
        {
          "start": 19.16,
          "end": 25.0,
          "text": "Vítajte pri Vedatorskom podcaste, v ktorom budeme diskutovať o vede a prírode okolo nás."
        },
        {
          "start": 25.18,
          "end": 28.14,
          "text": "Dnešnou témou je, ako skúmame vesmír."
        },
        {
          "start": 28.26,
          "end": 30.26,
          "text": "Ja som Jozef a ja Samuel."
        }
      ]
    },
    {
      "window": [
        330,
        349
      ],
      "segments": [
        {
          "start": 330.0,
          "end": 331.44,
          "text": "slabej jadrovej sily."
        },
        {
          "start": 331.54,
          "end": 333.86,
          "text": "A teda ako názov napovedá, ona je veľmi slabá."
        },
        {
          "start": 334.58,
          "end": 336.16,
          "text": "Tých neutrín je všade okolo"
        },
        {
          "start": 336.16,
          "end": 338.02,
          "text": "strašne veľa. Kým dopoviem túto"
        },
        {
          "start": 338.02,
          "end": 339.4,
          "text": "vetu, tak ich cez mňa preletí"
        },
        {
          "start": 339.4,
          "end": 341.9,
          "text": "biliarda a do konca života"
        },
        {
          "start": 341.9,
          "end": 343.22,
          "text": "sa v priemere zachytí jedno."
        },
        {
          "start": 343.3,
          "end": 345.26,
          "text": "To bola biliarda z B, nie M."
        },
        {
          "start": 347.06,
          "end": 348.1,
          "text": "Aby diváci"
        },
        {
          "start": 348.1,
          "end": 348.54,
          "text": "dobre..."
        }
      ]
    },
    {
      "window": [
        394,
        404
      ],
      "segments": [
        {
          "start": 394.0,
          "end": 397.66,
          "text": "Máme im do cesty veľa materiálu, aby bola čo najväčšia šanca, že ich zachytíme."
        },
        {
          "start": 398.66,
          "end": 402.48,
          "text": "To, čo oni urobia, je, že oni tam spôsobia premenu medzi protónom a neutrínom."
        }
      ]
    },
    {
      "window": [
        464,
        478
      ],
      "segments": [
        {
          "start": 464.0,
          "end": 465.84,
          "text": "využívať starú baňu, ale že zoberieme kopu"
        },
        {
          "start": 465.84,
          "end": 467.14,
          "text": "ľadu, ktorý sa nachádza na"
        },
        {
          "start": 468.92,
          "end": 469.74,
          "text": "Arktíde, alebo"
        },
        {
          "start": 469.74,
          "end": 471.72,
          "text": "Antarktíde, teraz nie som istý, myslím si, že"
        },
        {
          "start": 471.72,
          "end": 473.5,
          "text": "Antarktíde. Teraz ktoré chceš, lebo jedno je"
        },
        {
          "start": 473.5,
          "end": 475.78,
          "text": "zamrznuté oceán, tak to je Antarktíde."
        },
        {
          "start": 477.3,
          "end": 477.72,
          "text": "Čiže"
        }
      ]
    },
    {
      "window": [
        532,
        550
      ],
      "segments": [
        {
          "start": 533.52,
          "end": 539.98,
          "text": "Napríklad v Magalešovom mraku vybuchla supernova pred 168 tisíc rokmi,"
        },
        {
          "start": 540.06,
          "end": 547.44,
          "text": "dorazili neutrína k nám o 168 tisíc rokov 23. februára 1987."
        }
      ]
    },
    {
      "window": [
        590,
        610
      ],
      "segments": [
        {
          "start": 590.0,
          "end": 592.44,
          "text": "interagovalo a bolo zteda spomalené oproti neutrinám."
        },
        {
          "start": 593.4,
          "end": 596.38,
          "text": "Čiže supernová SN 1977A"
        },
        {
          "start": 596.38,
          "end": 598.92,
          "text": "je prvá udalosť, ktorú sme zachytili"
        },
        {
          "start": 598.92,
          "end": 601.32,
          "text": "dvomi spôsobmi, aj svetlom, aj neutrinami."
        },
        {
          "start": 601.34,
          "end": 605.18,
          "text": "Takže keby že ju nezachytíme svetlom, tak niekto nám vie povedať"
        },
        {
          "start": 605.18,
          "end": 608.36,
          "text": "vďaka vlastne tomu zachyteniu tých 25 neutrin,"
        },
        {
          "start": 608.48,
          "end": 609.86,
          "text": "že niekde vybuchla..."
        }
      ]
    },
    {
      "window": [
        645,
        663
      ],
      "segments": [
        {
          "start": 645.0,
          "end": 662.38,
          "text": "Na toto treba za prvé strašne drstné podmienky, čo znamená napríklad zrážku dvoch čiernych dier a za druhé extrémne citlivé detektory, lebo aj pri takto drastické odelosti je to stále efekt na dakom 20. mieste."
        }
      ]
    },
    {
      "window": [
        675,
        690
      ],
      "segments": [
        {
          "start": 679.84,
          "end": 681.24,
          "text": "Ďakujem."
        }
      ]
    },
    {
      "window": [
        766,
        780
      ],
      "segments": [
        {
          "start": 766.0,
          "end": 769.8,
          "text": "ale udelo sa to, neviem, či stovky miliónov kilometrov"
        },
        {
          "start": 769.8,
          "end": 772.96,
          "text": "alebo dokonca miliardy, nie kilometrov, ale svetelných rokov."
        },
        {
          "start": 773.6,
          "end": 775.08,
          "text": "Takže v bezpečnom odstupe to bolo."
        },
        {
          "start": 775.26,
          "end": 779.98,
          "text": "Takže nám nič nehrozilo z tejto zrážky, ale my sme ich mohli..."
        }
      ]
    },
    {
      "window": [
        812,
        825
      ],
      "segments": [
        {
          "start": 812.0,
          "end": 815.48,
          "text": "to niekto nevložil. Chýbal tam taký nezávislý pokus od iného"
        },
        {
          "start": 816.48,
          "end": 819.04,
          "text": "experimentálneho zariadenia, nezávislý od niektorých, ktorý by to potvrdil."
        },
        {
          "start": 819.24,
          "end": 823.44,
          "text": "Ale potom už sa tieto veci poverovali, už sa tomu viac menej 100% neverí."
        }
      ]
    },
    {
      "window": [
        928,
        940
      ],
      "segments": [
        {
          "start": 928.92,
          "end": 930.74,
          "text": "gravitačné vlny, ktoré vieme pozorovať."
        },
        {
          "start": 931.14,
          "end": 932.48,
          "text": "Áno, a teda bol taký jeden"
        },
        {
          "start": 932.48,
          "end": 934.34,
          "text": "zaujímavý, jedno zaujímavé pozorovanie,"
        },
        {
          "start": 934.42,
          "end": 935.9,
          "text": "ktoré sa volá, že G2TV"
        },
        {
          "start": 935.9,
          "end": 937.64,
          "text": "170 817"
        },
        {
          "start": 939.06,
          "end": 939.98,
          "text": "a to bolo"
        }
      ]
    },
    {
      "window": [
        973,
        987
      ],
      "segments": [
        {
          "start": 973.0,
          "end": 973.72,
          "text": "Správne chápem."
        },
        {
          "start": 973.84,
          "end": 976.72,
          "text": "Áno, tomu sa hovorí, že taký veľký triumf astrofizike"
        },
        {
          "start": 976.72,
          "end": 978.7,
          "text": "alebo taká v odzokách rosetovská doska,"
        },
        {
          "start": 978.74,
          "end": 984.36,
          "text": "že pozorovať jeden jav aj pomocou svetla,"
        },
        {
          "start": 984.38,
          "end": 986.7,
          "text": "aj pomocou neutrina, aj pomocou gravitačných vln."
        }
      ]
    },
    {
      "window": [
        1038,
        1062
      ],
      "segments": [
        {
          "start": 1038.7,
          "end": 1040.56,
          "text": "čo najprv bolo také sklamanie"
        },
        {
          "start": 1040.56,
          "end": 1042.68,
          "text": "ale potom sa vlastne zistilo, že tie neutrína"
        },
        {
          "start": 1042.68,
          "end": 1044.8,
          "text": "pravdepodobne majú pôvod na Zemi"
        },
        {
          "start": 1044.8,
          "end": 1046.38,
          "text": "lebo bola vtedy strašne silná búrka"
        },
        {
          "start": 1047.12,
          "end": 1049.36,
          "text": "a oni vznikajú aj pri takých"
        },
        {
          "start": 1049.36,
          "end": 1051.22,
          "text": "keď veľmi silné blesky"
        },
        {
          "start": 1051.22,
          "end": 1052.78,
          "text": "šľahajú, tak ich môžu vznikať"
        },
        {
          "start": 1052.78,
          "end": 1053.66,
          "text": "v trochu väčšom počte"
        },
        {
          "start": 1053.66,
          "end": 1056.62,
          "text": "tak pravdepodobne takéto ich navýšenie"
        },
        {
          "start": 1056.62,
          "end": 1059.02,
          "text": "meraní bolo spôsobené tou búrkou"
        },
        {
          "start": 1059.02,
